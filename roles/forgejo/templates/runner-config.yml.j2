# Forgejo Actions runner config, re-rendered by Ansible on every run (the
# previous version is kept as a timestamped backup next to it). Edit the
# template in roles/forgejo/templates/, not this file. Only the fields this
# role needs are listed — everything else uses forgejo-runner's built-in
# defaults; see https://forgejo.org/docs/latest/admin/actions/configuration/

runner:
  name: "{{ forgejo_runner_name }}"
  labels:
{% for label in forgejo_runner_labels %}
    - "{{ label }}"
{% endfor %}
{% if forgejo_ci_image_enabled | bool %}
    - "{{ forgejo_ci_label }}:docker://{{ forgejo_ci_image_name }}"
{% endif %}

container:
  # Job containers join the same Podman network as Forgejo so the instance
  # URL below (http://forgejo:3000) resolves inside a job; without this,
  # actions/checkout cannot reach the server.
  network: "{{ forgejo_network_name }}"
  # The scanner image only exists in local storage; never try to pull it.
  force_pull: false

server:
  connections:
    forgejo:
      url: "{{ forgejo_runner_instance_url }}"
      uuid: "{{ forgejo_runner_uuid }}"
      token: "{{ forgejo_runner_secret }}"
