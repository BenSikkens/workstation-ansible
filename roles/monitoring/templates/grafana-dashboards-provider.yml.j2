# Managed by Ansible (roles/monitoring). Dashboards are loaded from the JSON
# files in the dashboards directory; edits made in the UI are not persisted
# (use "Save as" for your own copies).
apiVersion: 1

providers:
  - name: homelab
    orgId: 1
    folder: Homelab
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 60
    options:
      path: /var/lib/grafana-dashboards

  # Dashboards that other roles register with the monitor_app role: one
  # sub-directory per application, shown as a Grafana folder of that name.
  # Removing a file removes the dashboard (the files are the source of truth).
  - name: apps
    orgId: 1
    type: file
    disableDeletion: false
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /var/lib/grafana-app-dashboards
      foldersFromFilesStructure: true
