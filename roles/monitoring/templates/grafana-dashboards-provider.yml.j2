# Managed by Ansible (roles/monitoring). Dashboards are loaded from the JSON
# files in the dashboards directory; edits made in the UI are not persisted
# (use "Save as" for your own copies).
apiVersion: 1

providers:
  - name: homelab
    orgId: 1
    folder: Homelab
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 60
    options:
      path: /var/lib/grafana-dashboards
