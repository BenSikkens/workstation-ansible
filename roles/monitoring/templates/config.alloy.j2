// Managed by Ansible (roles/monitoring). Local edits are overwritten on the
// next playbook run; a timestamped backup is kept.
//
// One agent for the whole workstation. It sends:
//   * host metrics (CPU, memory, disk, network)          -> Prometheus
//   * per-container metrics from each Podman exporter    -> Prometheus
//   * CI scan results held by the Pushgateway            -> Prometheus
//   * metrics of applications that registered themselves -> Prometheus
//   * cv-microfrontend pods on k3s (metrics and logs)    -> Prometheus, Loki
//   * the systemd journal (incl. container logs)         -> Loki
// Everything stays on 127.0.0.1.

prometheus.remote_write "local" {
  endpoint {
    url = "http://127.0.0.1:{{ monitoring_prometheus_port }}/api/v1/write"
  }
}

// --- host metrics (embedded node_exporter) ---
prometheus.exporter.unix "host" {
  netdev {
    device_exclude = "^(veth.*|podman.*|cni.*|br-.*|lo)$"
  }
}

prometheus.scrape "host" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.remote_write.local.receiver]
}

// --- rootless Podman containers, one exporter per user ---
prometheus.scrape "podman" {
  targets = [
{% for e in monitoring_exporters_active %}
    {"__address__" = "127.0.0.1:{{ e.port }}", "podman_user" = "{{ e.user }}"},
{% endfor %}
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

{% if monitoring_pushgateway_enabled | default(false) | bool %}
// --- CI scan results pushed by workflows ---
prometheus.scrape "pushgateway" {
  targets      = [{"__address__" = "127.0.0.1:{{ monitoring_pushgateway_port }}"}]
  honor_labels = true
  forward_to   = [prometheus.remote_write.local.receiver]
}

{% endif %}
// --- applications that register themselves ---
// Each file in /etc/alloy/targets.d/ lists endpoints that serve Prometheus
// metrics (written by the monitor_app role, or by hand; Prometheus file_sd
// format). The `app` label becomes the `job` label.
discovery.file "apps" {
  files            = ["/etc/alloy/targets.d/*.yml", "/etc/alloy/targets.d/*.yaml", "/etc/alloy/targets.d/*.json"]
  refresh_interval = "30s"
}

discovery.relabel "apps" {
  targets = discovery.file.apps.targets

  rule {
    source_labels = ["app"]
    regex         = "(.+)"
    target_label  = "job"
  }
}

prometheus.scrape "apps" {
  targets         = discovery.relabel.apps.output
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

// --- logs from the systemd journal (system, user services, containers) ---
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  // Quadlet containers run as *user* services; they carry _SYSTEMD_USER_UNIT
  // instead, so it takes over the `unit` label when present.
  rule {
    source_labels = ["__journal__systemd_user_unit"]
    regex         = "(.+)"
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
}

loki.source.journal "journal" {
  forward_to    = [loki.write.local.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels        = {source = "journal"}
  max_age       = "12h"
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:{{ monitoring_loki_port }}/loki/api/v1/push"
  }
}

{% if monitoring_k3s_cv_enabled | default(false) | bool %}
// cv-microfrontend -- collecting the CV application on k3s. Uses the
// `prometheus.remote_write "local"` and `loki.write "local"` above and adds
// nothing that listens on a port.
//
// Needs {{ monitoring_k3s_cv_kubeconfig }}, readable by the alloy user: the
// read-only `cv-metrics-reader` account of the namespace (list/watch pods,
// read their logs). Pod IPs (10.42.x.x) are reachable from the host, so Alloy
// scrapes the pods directly -- no NodePort, no hostPort.

// --- which pods exist (shared by metrics and logs) ---
discovery.kubernetes "k3s_cv_pods" {
  role            = "pod"
  kubeconfig_file = "{{ monitoring_k3s_cv_kubeconfig }}"

  // The account can only see its own namespace, so discovery must be
  // limited to it as well.
  namespaces {
    names = ["{{ monitoring_k3s_cv_namespace }}"]
  }
}

// --- metrics ---
// Pods say where their metrics are with annotations:
//   prometheus.io/scrape: "true", prometheus.io/port, prometheus.io/path
discovery.relabel "k3s_cv_metrics" {
  targets = discovery.kubernetes.k3s_cv_pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    regex         = "true"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex         = "Running"
    action        = "keep"
  }
  // Discovery gives one target per container port; all of a pod's
  // targets become the same podIP:<annotated port>, and identical
  // targets are scraped once.
  rule {
    source_labels = ["__meta_kubernetes_pod_ip", "__meta_kubernetes_pod_annotation_prometheus_io_port"]
    regex         = "(.+);(\\d+)"
    replacement   = "$1:$2"
    target_label  = "__address__"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
  }
  rule {
    target_label = "job"
    replacement  = "k3s-pods"
  }
}

prometheus.scrape "k3s_cv_metrics" {
  targets         = discovery.relabel.k3s_cv_metrics.output
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

// --- logs ---
// Container logs through the Kubernetes API (k3s writes them to
// /var/log/pods, which only root can read). One stream per container.
discovery.relabel "k3s_cv_logs" {
  targets = discovery.kubernetes.k3s_cv_pods.targets

  // A container with two ports is discovered twice; the metrics port
  // is the duplicate, so drop it to read each log once.
  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_number"]
    regex         = "{{ monitoring_k3s_cv_metrics_port }}"
    action        = "drop"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
  }
  // Next to the journal's source="journal" in the workstation's Loki.
  rule {
    target_label = "source"
    replacement  = "k3s"
  }
}

loki.source.kubernetes "k3s_cv_logs" {
  targets    = discovery.relabel.k3s_cv_logs.output
  forward_to = [loki.write.local.receiver]

  client {
    kubeconfig_file = "{{ monitoring_k3s_cv_kubeconfig }}"
  }
}
{% endif %}
