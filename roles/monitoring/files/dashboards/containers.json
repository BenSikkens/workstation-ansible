    {
      "id": 7,
      "type": "table",
      "title": "Containers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "podman_container_state{podman_user=~\"$podman_user\"} * on(id) group_left(name) podman_container_info",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "id": true,
              "pod_id": true,
              "pod_name": true,
              "ports": true,
              "exit_code_": true
            },
            "renameByName": {
              "name": "Container",
              "image": "Image",
              "podman_user": "User",
              "state": "State",
              "Value": "State code"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Resources per container",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
